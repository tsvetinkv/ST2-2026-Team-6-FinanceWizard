@model WalletCreateViewModel
@{
    ViewData["Title"] = "Edit wallet";
    var walletId = ViewData["WalletId"];
}

@* Form pre-filled from the wallet, same partial as Create. *@
<partial name="_WalletForm" model="Model" />

@* Danger zone: a wallet can only be deleted when it has no transactions
   (WalletService.DeleteWalletAsync throws otherwise, and the controller shows TempData["ErrorMessage"]). *@
<section class="fw-panel fw-form-card fw-danger-zone" aria-labelledby="delete-wallet-h">
    <h2 id="delete-wallet-h">Delete this wallet</h2>
    <p>A wallet can only be deleted when it has no transactions. Delete its transactions first.</p>
    <form asp-action="Delete" asp-route-id="@walletId" method="post"
          onsubmit="return confirm('Delete this wallet? This cannot be undone.');">
        <button type="submit" class="btn fw-btn-danger">Delete wallet</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

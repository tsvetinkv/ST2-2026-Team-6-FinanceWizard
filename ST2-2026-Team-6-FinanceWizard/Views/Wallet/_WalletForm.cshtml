@model WalletCreateViewModel
@{
    // Same partial for Create and Edit.
    bool isEdit = ViewData["WalletId"] != null;
    string? routeId = isEdit ? ViewData["WalletId"]!.ToString() : null;

    // Normalise legacy symbols (€) to their ISO code, so the selected <option> works.
    var selectedCurrency = CurrencyInfo.Find(Model.Currency)?.Code ?? Model.Currency;
}

<div class="fw-panel fw-form-card">
    <h1 class="fw-page-title fw-form-title">@(isEdit ? "Edit wallet" : "New wallet")</h1>
    <p class="fw-muted fw-form-sub">@(isEdit ? "Change the details of this wallet." : "Choose what the wallet is for and how much is in it today.")</p>

    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@routeId" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="fw-alert-error" role="alert"></div>

        @* Wallet type as radio cards. The two options match WalletTypes.All,
           and the controller falls back to Spending if an unknown value arrives. *@
        <fieldset class="fw-form-group">
            <legend class="fw-label">Type</legend>
            <div class="fw-choice-grid">
                <div class="fw-choice">
                    <input type="radio" asp-for="Type" value="@WalletTypes.Spending" id="wtype-spending" />
                    <label for="wtype-spending">
                        <span class="fw-avatar" style="--h:215"><partial name="_SectionIcon" model="@("spending")" /></span>
                        <span>
                            <span class="fw-choice-title">Spending</span>
                            <span class="fw-choice-sub">Everyday expenses</span>
                        </span>
                    </label>
                </div>
                <div class="fw-choice">
                    <input type="radio" asp-for="Type" value="@WalletTypes.Savings" id="wtype-savings" />
                    <label for="wtype-savings">
                        <span class="fw-avatar" style="--h:42"><partial name="_SectionIcon" model="@("savings")" /></span>
                        <span>
                            <span class="fw-choice-title">Savings</span>
                            <span class="fw-choice-sub">Money you put aside</span>
                        </span>
                    </label>
                </div>
            </div>
            <span asp-validation-for="Type" class="fw-error"></span>
        </fieldset>

        <div class="fw-form-group">
            <label asp-for="Name" class="fw-label"></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Main account, Holiday fund" maxlength="60" />
            <span asp-validation-for="Name" class="fw-error"></span>
        </div>

        @* Balance + currency side by side. The label changes between "Initial amount"
           (Create) and "Balance" (Edit), matching the semantics of the two actions. *@
        <div class="fw-form-row">
            <div class="fw-form-group">
                <label asp-for="Balance" class="fw-label">@(isEdit ? "Balance" : "Initial amount")</label>
                <input asp-for="Balance" type="number" step="0.01" min="0" inputmode="decimal" class="form-control fw-amount-input" placeholder="0.00" />
                <span asp-validation-for="Balance" class="fw-error"></span>
            </div>
            <div class="fw-form-group">
                <label asp-for="Currency" class="fw-label"></label>
                <select asp-for="Currency" class="form-select">
                    @foreach (var c in CurrencyInfo.All)
                    {
                        <option value="@c.Code" selected="@(selectedCurrency == c.Code)">@c.Code</option>
                    }
                </select>
                <span asp-validation-for="Currency" class="fw-error"></span>
            </div>
        </div>

        @if (isEdit)
        {
            @* Extra warning shown only on the Edit page: changing the currency also
               converts every transaction amount on the wallet. *@
            <div class="fw-hint">
                When you change the currency of an existing wallet, its balance and transactions are converted at today's exchange rate.
            </div>
        }

        <div class="fw-form-actions">
            <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Create wallet")</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@model IEnumerable<Wallet>
@{
    ViewData["Title"] = "Wallets";

    var wallets = Model.ToList();

    // One block per currency: wallets in different currencies are never added together
    var currencyGroups = wallets
        .GroupBy(w => w.Currency)
        .OrderBy(g => g.Key)
        .ToList();
}

<div class="fw-page-head">
    <div>
        <h1 class="fw-page-title">Wallets<span class="fw-count-badge">@wallets.Count</span></h1>
        <p class="fw-page-sub">Keep your everyday spending apart from your savings.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg>
        New wallet
    </a>
</div>

@if (wallets.Any())
{
    <section class="fw-panel fw-summary" aria-label="Total balance">
        <div class="fw-summary-label">Total balance</div>
        <div class="fw-currency-tiles">
            @foreach (var group in currencyGroups)
            {
                <div class="fw-currency-tile">
                    <div class="fw-currency-code">@group.Key</div>
                    <div class="fw-summary-value">@Money.Format(group.Sum(w => w.Balance), group.Key)</div>
                    <div class="fw-summary-sub">@group.Count() @(group.Count() == 1 ? "wallet" : "wallets")</div>
                </div>
            }
        </div>
    </section>

    @foreach (var group in currencyGroups)
    {
        <section class="fw-currency-section" aria-labelledby="currency-@group.Key">
            <div class="fw-currency-head">
                <h2 id="currency-@group.Key">@group.Key wallets <span class="fw-count-badge">@group.Count()</span></h2>
                <span class="fw-summary-sub">Total @Money.Format(group.Sum(w => w.Balance), group.Key)</span>
            </div>

            <div class="fw-wallet-grid">
                @foreach (var wallet in group)
                {
                    bool isSavings = wallet.Type == WalletTypes.Savings;
                    <article class="fw-panel fw-wallet-card @(isSavings ? "is-savings" : "")">
                        <div class="fw-wallet-top">
                            <h3 class="fw-wallet-name">@wallet.Name</h3>
                            <span class="fw-type-badge @(isSavings ? "is-savings" : "")">
                                <partial name="_SectionIcon" model="@(isSavings ? "savings" : "spending")" />
                                @(isSavings ? "Savings" : "Spending")
                            </span>
                        </div>
                        <div class="fw-wallet-label">Balance</div>
                        <div class="fw-wallet-balance">@Money.Format(wallet.Balance, wallet.Currency)</div>

                        <div class="fw-card-actions">
                            <a asp-action="Edit" asp-route-id="@wallet.Id" class="fw-wallet-edit" aria-label="Edit wallet @wallet.Name">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
                                Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@wallet.Id" method="post" class="fw-inline-form"
                                  onsubmit="return confirm('Delete this wallet? This is only possible when it has no transactions.');">
                                <button type="submit" class="fw-wallet-delete" aria-label="Delete wallet @wallet.Name">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14" /></svg>
                                    Delete
                                </button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
}
else
{
    <section class="fw-panel">
        <div class="fw-empty">
            <partial name="_SectionIcon" model="@("wallets")" />
            <h2>No wallets yet</h2>
            <p>Create a spending wallet or a savings wallet to start tracking.</p>
            <a asp-action="Create" class="btn btn-primary fw-btn-sm">New wallet</a>
        </div>
    </section>
}

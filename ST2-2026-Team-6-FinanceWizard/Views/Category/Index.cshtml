@model IEnumerable<Category>
@{
    ViewData["Title"] = "Categories";
    var categories = Model.ToList();
    var search = ViewData["SearchName"] as string;
}

@* Page header with a count badge and the "Add category" primary action. *@
<div class="fw-page-head">
    <div>
        <h1 class="fw-page-title">Categories<span class="fw-count-badge">@categories.Count</span></h1>
        <p class="fw-page-sub">Group your transactions by what they are for.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg>
        Add category
    </a>
</div>

@* Search form. Method GET: the query string keeps the search after a refresh or back navigation.
   The <input> preserves its value via the value="@search" so the field is not cleared. *@
<form method="get" asp-action="Index" class="fw-panel fw-filter" role="search" aria-label="Search categories">
    <div class="fw-filter-field fw-filter-search">
        <label for="searchName" class="fw-label">Search</label>
        <input type="search" id="searchName" name="searchName" value="@search" class="form-control fw-control-sm" placeholder="Search categories" autocomplete="off" />
    </div>
    <div class="fw-filter-actions">
        <button type="submit" class="btn btn-primary fw-btn-sm">Search</button>
        <a asp-action="Index" class="btn btn-secondary fw-btn-sm">Reset</a>
    </div>
</form>

@if (categories.Any())
{
    @* Card grid: one card per category. Colours come from Colors.Style / Colors.Class,
       which handle both user-chosen colours (#rrggbb) and the automatic hue derived from the name. *@
    <div class="fw-card-grid">
        @foreach (var item in categories)
        {
            <article class="fw-panel fw-item-card">
                <span class="fw-avatar @Colors.Class(item.Color)" style="@Colors.Style(item.Color, item.Name)" aria-hidden="true">
                    <partial name="_CategoryIcon" model="item.Icon" />
                </span>
                <div class="fw-item-main">
                    <div class="fw-item-name">@item.Name</div>
                    <div class="fw-item-meta">Category</div>
                </div>
                <div class="fw-item-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="fw-icon-btn" title="Edit category" aria-label="Edit category @item.Name">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
                    </a>
                    @* Delete is POST, never GET, so a link-prefetcher cannot delete data.
                       The onsubmit confirmation gives the user a chance to cancel. *@
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                          onsubmit="return confirm('Delete this category? Transactions in it keep their amount and date but lose the category.');">
                        <button type="submit" class="fw-icon-btn is-danger" title="Delete category" aria-label="Delete category @item.Name">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6" /></svg>
                        </button>
                    </form>
                </div>
            </article>
        }
    </div>
}
else
{
    @* Empty state: two variants — "no matches for the search" vs "nothing at all".
       Each has its own CTA so the user knows what to do next. *@
    <section class="fw-panel">
        <div class="fw-empty">
            <partial name="_SectionIcon" model="@("categories")" />
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <h2>No matching categories</h2>
                <p>Try a different search term.</p>
                <a asp-action="Index" class="btn btn-secondary fw-btn-sm">Reset search</a>
            }
            else
            {
                <h2>No categories yet</h2>
                <p>Create categories like Groceries, Bills or Fun.</p>
                <a asp-action="Create" class="btn btn-primary fw-btn-sm">Add category</a>
            }
        </div>
    </section>
}

@model string
@{
    var key = (Model ?? string.Empty).Trim().ToLowerInvariant();

    // Icons that were already used before the icon library was added keep their own drawing;
    // every other name is an icon from the Bootstrap Icons library.
    //
    // Why the whitelist check:
    // - Rendering <i class="bi bi-@key"> with an arbitrary key would let a tampered request
    //   inject arbitrary CSS classes (e.g. containing quotes / spaces).
    // - Only letters, digits and dashes are allowed, and only for names NOT in the built-in
    //   set (the built-ins use their own SVG and would otherwise lose that art).
    var builtIn = new HashSet<string> { "cart", "bolt", "film", "home", "car", "heart", "gift", "coffee", "book", "plane", "tag" };
    bool fromLibrary = key.Length > 0 && !builtIn.Contains(key) && key.All(ch => char.IsAsciiLetterOrDigit(ch) || ch == '-');
}
@if (fromLibrary)
{
    <i class="bi bi-@key fw-bi" aria-hidden="true"></i>
}
else
{
    @* Built-in icons are inline SVG so they keep their original shapes across Bootstrap Icons upgrades. *@
    <svg class="fw-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        @switch (key)
        {
            case "cart":
                <circle cx="9" cy="21" r="1" />
                <circle cx="20" cy="21" r="1" />
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                break;
            case "bolt":
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                break;
            case "film":
                <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18" />
                <line x1="7" y1="2" x2="7" y2="22" />
                <line x1="17" y1="2" x2="17" y2="22" />
                <line x1="2" y1="12" x2="22" y2="12" />
                <line x1="2" y1="7" x2="7" y2="7" />
                <line x1="2" y1="17" x2="7" y2="17" />
                <line x1="17" y1="17" x2="22" y2="17" />
                <line x1="17" y1="7" x2="22" y2="7" />
                break;
            case "home":
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
                break;
            case "car":
                <path d="M5 17h14M3 13l2-6h14l2 6v4H3z" />
                <circle cx="7.5" cy="17" r="1.5" />
                <circle cx="16.5" cy="17" r="1.5" />
                break;
            case "heart":
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                break;
            case "gift":
                <polyline points="20 12 20 22 4 22 4 12" />
                <rect x="2" y="7" width="20" height="5" />
                <line x1="12" y1="22" x2="12" y2="7" />
                <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z" />
                <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" />
                break;
            case "coffee":
                <path d="M18 8h1a4 4 0 0 1 0 8h-1" />
                <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4z" />
                <line x1="6" y1="1" x2="6" y2="4" />
                <line x1="10" y1="1" x2="10" y2="4" />
                <line x1="14" y1="1" x2="14" y2="4" />
                break;
            case "book":
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                break;
            case "plane":
                <path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z" />
                break;
            default:
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
                <line x1="7" y1="7" x2="7.01" y2="7" />
                break;
        }
    </svg>
}

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsCurrent(string c, string a) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase)
                                          && string.Equals(action, a, StringComparison.OrdinalIgnoreCase);
    bool IsSection(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - FinanceWizard</title>

    <script>
        (function () {
            var theme = null;
            try { theme = localStorage.getItem('fw-theme'); } catch (e) { }
            if (theme !== 'light' && theme !== 'dark') {
                theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="fw-skip-link" href="#main">Skip to main content</a>

    <header>
        <nav class="navbar navbar-expand-md navbar-dark fw-navbar mb-4" data-bs-theme="dark" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                        <rect width="32" height="32" rx="8" fill="#f2c75c" />
                        <path d="M7 22l6-7 5 4 7-9" fill="none" stroke="#0f2a6b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>Finance<span class="fw-brand-accent">Wizard</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(IsCurrent("Home", "Index") ? "active" : "")"
                                   aria-current="@(IsCurrent("Home", "Index") ? "page" : null)"
                                   asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsSection("Transactions") ? "active" : "")"
                                   aria-current="@(IsSection("Transactions") ? "page" : null)"
                                   asp-controller="Transactions" asp-action="Index">Transactions</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsSection("Wallet") ? "active" : "")"
                                   aria-current="@(IsSection("Wallet") ? "page" : null)"
                                   asp-controller="Wallet" asp-action="Index">Wallets</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsSection("Category") ? "active" : "")"
                                   aria-current="@(IsSection("Category") ? "page" : null)"
                                   asp-controller="Category" asp-action="Index">Categories</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsSection("Merchant") ? "active" : "")"
                                   aria-current="@(IsSection("Merchant") ? "page" : null)"
                                   asp-controller="Merchant" asp-action="Index">Merchants</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsSection("Tag") ? "active" : "")"
                                   aria-current="@(IsSection("Tag") ? "page" : null)"
                                   asp-controller="Tag" asp-action="Index">Tags</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsSection("Assistant") ? "active" : "")"
                                   aria-current="@(IsSection("Assistant") ? "page" : null)"
                                   asp-controller="Assistant" asp-action="Index">
                                    <i class="bi bi-robot me-1" aria-hidden="true"></i>AI Advisor
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-md-center">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <span class="navbar-text me-md-2">Hello, @User.Identity.Name!</span>
                            </li>
                            <li class="nav-item py-2 py-md-0">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @(IsCurrent("Account", "Login") ? "active" : "")"
                                   aria-current="@(IsCurrent("Account", "Login") ? "page" : null)"
                                   asp-controller="Account" asp-action="Login">Log in</a>
                            </li>
                            <li class="nav-item py-2 py-md-0">
                                <a class="btn btn-gold btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                        <li class="nav-item py-2 py-md-0">
                            <button type="button" id="themeToggle" class="fw-theme-toggle" aria-label="Switch to dark mode" title="Switch theme">
                                <svg class="fw-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                                </svg>
                                <svg class="fw-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                    <circle cx="12" cy="12" r="4" />
                                    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                                </svg>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main id="main" role="main" class="pb-3">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    @successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="fw-footer py-4 mt-4">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small">
            <span>&copy; @DateTime.Now.Year FinanceWizard. All rights reserved.</span>
            <span>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                <span aria-hidden="true"> &middot; </span>
                Personal finance tracker
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var root = document.documentElement;
            var btn = document.getElementById('themeToggle');
            if (!btn) return;

            function syncLabel() {
                var isDark = root.getAttribute('data-bs-theme') === 'dark';
                var text = isDark ? 'Switch to light mode' : 'Switch to dark mode';
                btn.setAttribute('aria-label', text);
                btn.setAttribute('title', text);
            }

            syncLabel();

            btn.addEventListener('click', function () {
                var next = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                root.classList.add('fw-theme-anim');
                root.setAttribute('data-bs-theme', next);
                try { localStorage.setItem('fw-theme', next); } catch (e) { }
                syncLabel();
                window.setTimeout(function () { root.classList.remove('fw-theme-anim'); }, 450);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@model ST2_2026_Team_6_FinanceWizard.Models.TransactionListViewModel
@{
    ViewData["Title"] = "Транзакции";
}

<h2>Транзакции</h2>

<form method="get" class="card card-body bg-light mb-4 shadow-sm">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">От дата</label>
            <input asp-for="FromDate" type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">До дата</label>
            <input asp-for="ToDate" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Търсене</label>
            <input asp-for="SearchTerm" class="form-control" placeholder="Търсене по описание..." />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Търси</button>
        </div>
    </div>
</form>

<a asp-action="Create" class="btn btn-success mb-3">+ Нова транзакция</a>

@if (Model.Wallet != null)
{
    <div class="card bg-light mb-3 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h5 class="m-0 text-secondary">Текуща наличност:</h5>
            <h3 class="m-0 text-primary fw-bold">@Model.Wallet.Balance.ToString("N2") @Model.Wallet.Currency</h3>
        </div>
    </div>
}

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Дата</th>
            <th>Описание</th>
            <th>Тип</th>
            <th>Сума</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Transactions != null && Model.Transactions.Any())
        {
            @foreach (var t in Model.Transactions)
            {
                bool isIncome = string.Equals(t.Type, "Income", StringComparison.OrdinalIgnoreCase);

                <tr>
                    <td>@t.Date.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@(string.IsNullOrWhiteSpace(t.Description) ? "-" : t.Description)</td>
                    <td>
                        <span class="badge @(isIncome ? "bg-success" : "bg-danger")">
                            @(isIncome ? "Приход" : "Разход")
                        </span>
                    </td>
                    <td>
                        <span class="@(isIncome ? "text-success" : "text-danger") fw-bold">
                            @(isIncome ? "+" : "-")@t.Amount.ToString("N2") @(t.Wallet?.Currency ?? "€")
                        </span>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">Няма намерени транзакции.</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-SearchTerm="@Model.SearchTerm">@i</a>
                </li>
            }
        </ul>
    </nav>
}
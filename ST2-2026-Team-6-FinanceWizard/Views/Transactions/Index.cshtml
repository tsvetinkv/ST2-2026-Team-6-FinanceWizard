@model TransactionListViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Transactions";

    var inv = CultureInfo.InvariantCulture;
    var currency = Model.Wallet?.Currency ?? "€";
    var term = string.IsNullOrWhiteSpace(Model.SearchTerm) ? null : Model.SearchTerm;
    var fromStr = Model.FromDate?.ToString("yyyy-MM-dd", inv);
    var toStr = Model.ToDate?.ToString("yyyy-MM-dd", inv);
    bool hasFilters = fromStr != null || toStr != null || term != null;

    int firstPage = Math.Max(1, Model.CurrentPage - 2);
    int lastPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
}

<div class="fw-page-head">
    <h1 class="fw-page-title">Transactions</h1>
    <a asp-action="Create" class="btn btn-primary fw-btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg>
        New transaction
    </a>
</div>

<section class="fw-panel fw-summary" aria-label="Wallet summary">
    <div>
        <div class="fw-summary-label">Wallet balance</div>
        @if (Model.Wallet != null)
        {
            <div class="fw-summary-value">@(currency)@(Model.Wallet.Balance.ToString("N2", inv))</div>
        }
        else
        {
            <div class="fw-summary-value fw-summary-empty">Not available</div>
        }
    </div>
</section>

<form method="get" asp-action="Index" class="fw-panel fw-filter" role="search" aria-label="Filter transactions">
    <div class="fw-filter-field">
        <label asp-for="FromDate" class="fw-label">From</label>
        <input asp-for="FromDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control fw-control-sm" />
    </div>
    <div class="fw-filter-field">
        <label asp-for="ToDate" class="fw-label">To</label>
        <input asp-for="ToDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control fw-control-sm" />
    </div>
    <div class="fw-filter-field fw-filter-search">
        <label asp-for="SearchTerm" class="fw-label">Description</label>
        <input asp-for="SearchTerm" type="search" class="form-control fw-control-sm" placeholder="Search description" autocomplete="off" />
    </div>
    <div class="fw-filter-actions">
        <button type="submit" class="btn btn-primary fw-btn-sm">Search</button>
        <a asp-action="Index" class="btn btn-secondary fw-btn-sm">Reset</a>
    </div>
</form>

<section class="fw-panel fw-table-panel" aria-label="Transaction list">
    @if (Model.Transactions.Any())
    {
        <div class="fw-table-wrap">
            <table class="fw-table">
                <caption class="visually-hidden">
                    Transactions, newest first. Page @Model.CurrentPage of @Math.Max(Model.TotalPages, 1).
                </caption>
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Description</th>
                        <th scope="col">Type</th>
                        <th scope="col" class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Transactions)
                    {
                        bool isIncome = t.Type == "Income";
                        <tr>
                            <td class="fw-col-date">
                                <span class="fw-date-main">@t.Date.ToString("dd MMM yyyy", inv)</span>
                                <span class="fw-date-sub">@t.Date.ToString("HH:mm", inv)</span>
                            </td>
                            <td class="fw-col-desc">
                                @if (string.IsNullOrWhiteSpace(t.Description))
                                {
                                    <span class="fw-muted">No description</span>
                                }
                                else
                                {
                                    @t.Description
                                }
                            </td>
                            <td>
                                <span class="fw-tx-badge @(isIncome ? "is-income" : "is-expense")">
                                    @if (isIncome)
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M19 12l-7 7-7-7" /></svg>
                                    }
                                    @(isIncome ? "Income" : "Expense")
                                </span>
                            </td>
                            <td class="text-end">
                                <span class="fw-amount @(isIncome ? "is-income" : "is-expense")">@(isIncome ? "+" : "−")@(currency)@(t.Amount.ToString("N2", inv))</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="fw-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18M7 15h3" /></svg>
            @if (hasFilters)
            {
                <h2>No matching transactions</h2>
                <p>Try a different date range or search term.</p>
                <a asp-action="Index" class="btn btn-secondary fw-btn-sm">Reset filters</a>
            }
            else
            {
                <h2>No transactions yet</h2>
                <p>Add your first income or expense to get started.</p>
                <a asp-action="Create" class="btn btn-primary fw-btn-sm">New transaction</a>
            }
        </div>
    }
</section>

@if (Model.TotalPages > 1)
{
    <nav class="fw-pager" aria-label="Transactions pages">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-FromDate="@fromStr" asp-route-ToDate="@toStr" asp-route-SearchTerm="@term" rel="prev">Previous</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link" aria-disabled="true">Previous</span></li>
            }

            @if (firstPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-FromDate="@fromStr" asp-route-ToDate="@toStr" asp-route-SearchTerm="@term" aria-label="Page 1">1</a>
                </li>
                if (firstPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link" aria-hidden="true">&hellip;</span></li>
                }
            }

            @for (int p = firstPage; p <= lastPage; p++)
            {
                if (p == Model.CurrentPage)
                {
                    <li class="page-item active">
                        <span class="page-link" aria-current="page" aria-label="Page @p, current page">@p</span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-FromDate="@fromStr" asp-route-ToDate="@toStr" asp-route-SearchTerm="@term" aria-label="Page @p">@p</a>
                    </li>
                }
            }

            @if (lastPage < Model.TotalPages)
            {
                if (lastPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link" aria-hidden="true">&hellip;</span></li>
                }
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-FromDate="@fromStr" asp-route-ToDate="@toStr" asp-route-SearchTerm="@term" aria-label="Page @Model.TotalPages">@Model.TotalPages</a>
                </li>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-FromDate="@fromStr" asp-route-ToDate="@toStr" asp-route-SearchTerm="@term" rel="next">Next</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link" aria-disabled="true">Next</span></li>
            }
        </ul>
    </nav>
}

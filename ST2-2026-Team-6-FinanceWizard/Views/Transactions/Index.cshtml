@model TransactionListViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Transactions";

    var inv = CultureInfo.InvariantCulture;

    // Pre-format the filters for the pager links, so paging keeps the current filter state.
    var term = string.IsNullOrWhiteSpace(Model.SearchTerm) ? null : Model.SearchTerm;
    var fromStr = Model.FromDate?.ToString("yyyy-MM-dd", inv);
    var toStr = Model.ToDate?.ToString("yyyy-MM-dd", inv);
    bool hasFilters = fromStr != null || toStr != null || term != null;

    // Used as a "return here after delete" hint so the user lands back on the same page / filter.
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    // Pager window: always show at most 5 page numbers around the current page.
    int firstPage = Math.Max(1, Model.CurrentPage - 2);
    int lastPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
}

<div class="fw-page-head">
    <h1 class="fw-page-title">Transactions</h1>
    <a asp-action="Create" class="btn btn-primary fw-btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg>
        New transaction
    </a>
</div>

@* Wallet summary at the top of the page.
   Grouped by currency: balances of different currencies are never added together.
   Within each currency, wallets are listed as chips. *@
<section class="fw-panel fw-summary" aria-label="Wallet summary">
    @if (Model.Wallets.Any())
    {
        <div class="fw-summary-label">Total balance</div>
        <div class="fw-currency-tiles">
            @foreach (var group in Model.Wallets.GroupBy(w => w.Currency).OrderBy(g => g.Key))
            {
                <div class="fw-currency-tile">
                    <div class="fw-currency-code">@group.Key</div>
                    <div class="fw-summary-value">@Money.Format(group.Sum(w => w.Balance), group.Key)</div>
                    <ul class="fw-wallet-chips" aria-label="@group.Key wallets">
                        @foreach (var w in group)
                        {
                            bool sv = w.Type == WalletTypes.Savings;
                            <li class="fw-type-badge @(sv ? "is-savings" : "")" title="@w.Name">
                                <partial name="_SectionIcon" model="@(sv ? "savings" : "spending")" />
                                @w.Name: @Money.Format(w.Balance, w.Currency)
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
    else
    {
        <div class="fw-summary-label">Total balance</div>
        <div class="fw-summary-value fw-summary-empty">
            No wallets yet. <a asp-controller="Wallet" asp-action="Create">Create one</a>
        </div>
    }
</section>

@* Filter form: GET so the filters live in the query string and survive refresh / back.
   asp-for binds the fields to Model.FromDate / ToDate / SearchTerm, which preserves the current filter. *@
<form method="get" asp-action="Index" class="fw-panel fw-filter" role="search" aria-label="Filter transactions">
    <div class="fw-filter-field">
        <label asp-for="FromDate" class="fw-label">From</label>
        <input asp-for="FromDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control fw-control-sm" />
    </div>
    <div class="fw-filter-field">
        <label asp-for="ToDate" class="fw-label">To</label>
        <input asp-for="ToDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control fw-control-sm" />
    </div>
    <div class="fw-filter-field fw-filter-search">
        <label asp-for="SearchTerm" class="fw-label">Description</label>
        <input asp-for="SearchTerm" type="search" class="form-control fw-control-sm" placeholder="Search description" autocomplete="off" />
    </div>
    <div class="fw-filter-actions">
        <button type="submit" class="btn btn-primary fw-btn-sm">Search</button>
        <a asp-action="Index" class="btn btn-secondary fw-btn-sm">Reset</a>
    </div>
</form>

@* Table panel. The <caption> is visually hidden but still announced by screen readers.
   Each row shows: date, description (+ merchant + tags), category, wallet, type, amount, actions. *@
<section class="fw-panel fw-table-panel" aria-label="Transaction list">
    @if (Model.Transactions.Any())
    {
        <div class="fw-table-wrap">
            <table class="fw-table">
                <caption class="visually-hidden">
                    Transactions, newest first. Page @Model.CurrentPage of @Math.Max(Model.TotalPages, 1).
                </caption>
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Details</th>
                        <th scope="col">Category</th>
                        <th scope="col">Wallet</th>
                        <th scope="col">Type</th>
                        <th scope="col" class="text-end">Amount</th>
                        <th scope="col" class="fw-col-actions"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Transactions)
                    {
                        bool isIncome = t.Type == "Income";
                        string money = Money.Format(t.Amount, t.Wallet?.Currency);
                        bool walletIsSavings = t.Wallet?.Type == WalletTypes.Savings;
                        <tr>
                            @* Date cell: main date + time, stacked. Uses InvariantCulture so dates are stable. *@
                            <td class="fw-col-date">
                                <span class="fw-date-main">@t.Date.ToString("dd MMM yyyy", inv)</span>
                                <span class="fw-date-sub">@t.Date.ToString("HH:mm", inv)</span>
                            </td>
                            <td class="fw-col-desc">
                                @if (string.IsNullOrWhiteSpace(t.Description))
                                {
                                    <span class="fw-muted">No description</span>
                                }
                                else
                                {
                                    @t.Description
                                }
                                @if (t.Merchant != null)
                                {
                                    <span class="fw-tx-merchant">@t.Merchant.Name</span>
                                }
                                @if (t.TransactionTags.Any())
                                {
                                    @* Tags are sorted by name for a predictable order. *@
                                    <div class="fw-tx-tags">
                                        @foreach (var tt in t.TransactionTags.OrderBy(x => x.Tag.Name))
                                        {
                                            <span class="fw-tag is-sm @Colors.Class(tt.Tag.Color) @(string.IsNullOrEmpty(tt.Tag.Icon) ? "" : "has-icon")" style="@Colors.Style(tt.Tag.Color, tt.Tag.Name)">
                                                @if (!string.IsNullOrEmpty(tt.Tag.Icon))
                                                {
                                                    <partial name="_CategoryIcon" model="tt.Tag.Icon" />
                                                }
                                                @tt.Tag.Name
                                            </span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                @if (t.Category != null)
                                {
                                    <span class="fw-chip @Colors.Class(t.Category.Color)" style="@Colors.Style(t.Category.Color, t.Category.Name)">
                                        <span class="fw-chip-ico"><partial name="_CategoryIcon" model="t.Category.Icon" /></span>
                                        @t.Category.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="fw-muted">&mdash;</span>
                                }
                            </td>
                            <td>
                                @if (t.Wallet != null)
                                {
                                    <span class="fw-chip" style="--h:@(walletIsSavings ? 42 : 215)">
                                        <partial name="_SectionIcon" model="@(walletIsSavings ? "savings" : "spending")" />
                                        @t.Wallet.Name
                                    </span>
                                }
                            </td>
                            <td>
                                @* Income badge is green / up-arrow; expense is red / down-arrow. *@
                                <span class="fw-tx-badge @(isIncome ? "is-income" : "is-expense")">
                                    @if (isIncome)
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M19 12l-7 7-7-7" /></svg>
                                    }
                                    @(isIncome ? "Income" : "Expense")
                                </span>
                            </td>
                            <td class="text-end">
                                <span class="fw-amount @(isIncome ? "is-income" : "is-expense")">@(isIncome ? "+" : "−")@money</span>
                            </td>
                            <td class="fw-col-actions">
                                <div class="fw-tx-actions">
                                    <a asp-action="Edit" asp-route-id="@t.Id" class="fw-icon-btn" title="Edit transaction"
                                       aria-label="Edit @(isIncome ? "income" : "expense") of @money from @t.Date.ToString("dd MMM yyyy", inv)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
                                    </a>
                                    @* Delete is POST + confirmation. returnUrl lets the controller send the
                                       user back to the exact page (page number + filters) after deletion. *@
                                    <form asp-action="Delete" asp-route-id="@t.Id" method="post"
                                          onsubmit="return confirm('Delete this transaction? Your wallet balance will be updated.');">
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="fw-icon-btn is-danger"
                                                title="Delete transaction"
                                                aria-label="Delete @(isIncome ? "income" : "expense") of @money from @t.Date.ToString("dd MMM yyyy", inv)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        @* Empty state: with or without filters. *@
        <div class="fw-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18M7 15h3" /></svg>
            @if (hasFilters)
            {
                <h2>No matching transactions</h2>
                <p>Try a different date range or search term.</p>
                <a asp-action="Index" class="btn btn-secondary fw-btn-sm">Reset filters</a>
            }
            else
            {
                <h2>No transactions yet</h2>
                <p>Add your first income or expense to get started.</p>
                <a asp-action="Create" class="btn btn-primary fw-btn-sm">New transaction</a>
            }
        </div>
    }
</section>

@* Pager. Only shown when there is more than one page.
   Every link preserves FromDate / ToDate / SearchTerm, so switching pages keeps the current filter. *@
@if (Model.TotalPages > 1)
{
    <nav class="fw-pager" aria-label="Transactions pages">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            @* Previous button: disabled on page 1, otherwise a "rel=prev" link. *@
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-FromDate="@fromStr" asp-route-ToDate="@toStr" asp-route-SearchTerm="@term" rel="prev">Previous</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link" aria-disabled="true">Previous</span></li>
            }

            @* First page + "…" if the current window does not start at 1. *@
            @if (firstPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-FromDate="@fromStr" asp-route-ToDate="@toStr" asp-route-SearchTerm="@term" aria-label="Page 1">1</a>
                </li>
                if (firstPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link" aria-hidden="true">&hellip;</span></li>
                }
            }

            @* The page-number window. The current page is marked aria-current="page". *@
            @for (int p = firstPage; p <= lastPage; p++)
            {
                if (p == Model.CurrentPage)
                {
                    <li class="page-item active">
                        <span class="page-link" aria-current="page" aria-label="Page @p, current page">@p</span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-FromDate="@fromStr" asp-route-ToDate="@toStr" asp-route-SearchTerm="@term" aria-label="Page @p">@p</a>
                    </li>
                }
            }

            @* Last page + "…" if the window does not reach TotalPages. *@
            @if (lastPage < Model.TotalPages)
            {
                if (lastPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link" aria-hidden="true">&hellip;</span></li>
                }
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-FromDate="@fromStr" asp-route-ToDate="@toStr" asp-route-SearchTerm="@term" aria-label="Page @Model.TotalPages">@Model.TotalPages</a>
                </li>
            }

            @* Next button: disabled on the last page, otherwise a "rel=next" link. *@
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-FromDate="@fromStr" asp-route-ToDate="@toStr" asp-route-SearchTerm="@term" rel="next">Next</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link" aria-disabled="true">Next</span></li>
            }
        </ul>
    </nav>
}

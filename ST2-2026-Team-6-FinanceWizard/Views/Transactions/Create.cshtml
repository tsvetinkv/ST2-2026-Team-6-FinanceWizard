@model ST2_2026_Team_6_FinanceWizard.Models.TransactionCreateViewModel
@{
    ViewData["Title"] = "Добавяне на транзакция";
}

<h2>Добавяне на транзакция</h2>

<form asp-action="Create" method="post" class="mt-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label">Сума</label>
        <input asp-for="Amount" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Type" class="form-label">Тип</label>
        <select asp-for="Type" class="form-select">
            <option value="Expense">Разход</option>
            <option value="Income">Приход</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Описание</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Date" class="form-label">Дата</label>
        <input asp-for="Date" type="datetime-local" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Запази</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>
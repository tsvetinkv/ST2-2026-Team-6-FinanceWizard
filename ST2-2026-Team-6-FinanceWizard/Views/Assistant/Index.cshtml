@model ST2_2026_Team_6_FinanceWizard.Models.AssistantViewModel
@{
    ViewData["Title"] = "AI Financial Advisor";
}

@* The whole page's styling is scoped to this view (inline <style>) rather than added
   to site.css, because the assistant page is the only place that uses these colours.
   The custom properties (--fw-ai-*) follow the light / dark theme via [data-bs-theme="dark"]. *@
<style>
    /* ---------- Theme tokens ---------- */
    :root {
        --fw-ai-card-bg: #ffffff;
        --fw-ai-card-border: #dbe2ea;
        --fw-ai-chat-bg: #f5f7fb;
        --fw-ai-chat-border: #e2e8f0;
        --fw-ai-user-bubble: #1d4ed8;
        --fw-ai-user-text: #ffffff;
        --fw-ai-bot-bubble: #ffffff;
        --fw-ai-bot-border: #dbe2ea;
        --fw-ai-bot-text: #0f172a;
        --fw-ai-accent: #1d4ed8;
        --fw-ai-code-bg: #eef2f7;
        --fw-ai-disclaimer-bg: #eff6ff;
        --fw-ai-disclaimer-border: #bfdbfe;
        --fw-ai-disclaimer-text: #1e3a8a;
        --fw-ai-muted: #64748b;
    }

    [data-bs-theme="dark"] {
        --fw-ai-card-bg: #151922;
        --fw-ai-card-border: #2a3244;
        --fw-ai-chat-bg: #0b0d12;
        --fw-ai-chat-border: #232a3b;
        --fw-ai-user-bubble: #2563eb;
        --fw-ai-user-text: #ffffff;
        --fw-ai-bot-bubble: #1a1f2b;
        --fw-ai-bot-border: #2f3a50;
        --fw-ai-bot-text: #e2e8f0;
        --fw-ai-accent: #60a5fa;
        --fw-ai-code-bg: #0f131c;
        --fw-ai-disclaimer-bg: #172033;
        --fw-ai-disclaimer-border: #2f3a50;
        --fw-ai-disclaimer-text: #93c5fd;
        --fw-ai-muted: #94a3b8;
    }

    /* ---------- Layout ---------- */
    .fw-ai-card {
        background-color: var(--fw-ai-card-bg);
        border: 1px solid var(--fw-ai-card-border);
        border-radius: 14px;
        box-shadow: 0 6px 24px rgba(15, 23, 42, 0.07);
        padding: 2rem;
    }

    .fw-ai-chat-box {
        background-color: var(--fw-ai-chat-bg);
        border: 1px solid var(--fw-ai-chat-border);
        border-radius: 12px;
        min-height: 320px;
        max-height: 520px;
        overflow-y: auto;
        padding: 1.5rem;
    }

    .fw-ai-disclaimer {
        background-color: var(--fw-ai-disclaimer-bg);
        border: 1px solid var(--fw-ai-disclaimer-border);
        color: var(--fw-ai-disclaimer-text);
        border-radius: 10px;
        font-size: 0.875rem;
        padding: 0.75rem 1rem;
    }

    /* ---------- Message rows ---------- */
    .fw-msg-row {
        display: flex;
        margin-bottom: 1.1rem;
    }

        .fw-msg-row.is-user {
            justify-content: flex-end;
        }

        .fw-msg-row.is-bot {
            justify-content: flex-start;
        }

    .fw-bubble {
        max-width: 80%;
        border-radius: 14px;
        padding: 0.9rem 1.15rem;
    }

    .fw-msg-row.is-bot .fw-bubble {
        max-width: 92%;
        width: 100%;
    }

    .fw-bubble-user {
        background-color: var(--fw-ai-user-bubble);
        color: var(--fw-ai-user-text);
        border-radius: 14px 14px 3px 14px;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25);
    }

    .fw-bubble-bot {
        background-color: var(--fw-ai-bot-bubble);
        color: var(--fw-ai-bot-text);
        border: 1px solid var(--fw-ai-bot-border);
        border-radius: 14px 14px 14px 3px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    }

    .fw-bubble-header {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        opacity: 0.75;
        margin-bottom: 0.5rem;
    }

    .fw-bubble-time {
        text-align: right;
        font-size: 0.68rem;
        opacity: 0.65;
        margin-top: 0.5rem;
    }

    /* ---------- Rendered Markdown (advisor replies) ---------- */
    .fw-md {
        font-size: 0.95rem;
        line-height: 1.65;
    }

        .fw-md > :first-child {
            margin-top: 0;
        }

        .fw-md > :last-child {
            margin-bottom: 0;
        }

        .fw-md p {
            margin: 0 0 0.7rem;
        }

        .fw-md h1,
        .fw-md h2,
        .fw-md h3,
        .fw-md h4 {
            font-size: 1.02rem;
            font-weight: 700;
            color: var(--fw-ai-accent);
            margin: 1.1rem 0 0.45rem;
            padding-left: 0.6rem;
            border-left: 3px solid var(--fw-ai-accent);
        }

        .fw-md ul,
        .fw-md ol {
            margin: 0 0 0.75rem;
            padding-left: 1.4rem;
        }

        .fw-md li {
            margin-bottom: 0.3rem;
        }

            .fw-md li::marker {
                color: var(--fw-ai-accent);
            }

        .fw-md strong {
            font-weight: 700;
        }

        .fw-md code {
            background-color: var(--fw-ai-code-bg);
            border-radius: 5px;
            padding: 0.1rem 0.35rem;
            font-size: 0.88em;
        }

        .fw-md table {
            width: 100%;
            border-collapse: collapse;
            margin: 0.6rem 0 0.9rem;
            font-size: 0.9rem;
        }

        .fw-md th,
        .fw-md td {
            border: 1px solid var(--fw-ai-bot-border);
            padding: 0.45rem 0.6rem;
            text-align: left;
        }

        .fw-md th {
            background-color: var(--fw-ai-code-bg);
            font-weight: 600;
        }

        .fw-md hr {
            border: 0;
            border-top: 1px solid var(--fw-ai-bot-border);
            margin: 0.9rem 0;
        }

    .fw-plain {
        white-space: pre-wrap;
        word-break: break-word;
    }

    /* ---------- Prompt pills & form ---------- */
    .fw-prompt-pill {
        background-color: var(--fw-ai-bot-bubble);
        border: 1px solid var(--fw-ai-bot-border);
        color: var(--fw-ai-bot-text);
        border-radius: 999px;
        padding: 0.45rem 1rem;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }

        .fw-prompt-pill:hover {
            background-color: var(--fw-ai-user-bubble);
            color: #ffffff;
            border-color: var(--fw-ai-user-bubble);
        }

    .fw-char-counter {
        font-size: 0.75rem;
        color: var(--fw-ai-muted);
        font-weight: 600;
    }

    .fw-section-label {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--fw-ai-muted);
    }

    .fw-key-hint {
        font-size: 0.75rem;
        color: var(--fw-ai-muted);
    }

    /* ---------- Entrance animations ---------- */
    @@keyframes fw-fade-up {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fw-dot-bounce {
        0%, 80%, 100% {
            transform: translateY(0);
            opacity: 0.35;
        }

        40% {
            transform: translateY(-4px);
            opacity: 1;
        }
    }

    .fw-msg-row.fw-animate {
        animation: fw-fade-up 0.45s ease-out both;
    }

        .fw-msg-row.fw-animate .fw-bubble {
            animation: fw-fade-up 0.45s ease-out 0.05s both;
        }

    /* Typing indicator shown while waiting for the reply */
    .fw-typing {
        display: none;
        align-items: center;
        gap: 0.35rem;
        padding: 0.85rem 1.15rem;
        margin-bottom: 1.1rem;
        width: fit-content;
        background-color: var(--fw-ai-bot-bubble);
        border: 1px solid var(--fw-ai-bot-border);
        border-radius: 14px 14px 14px 3px;
        animation: fw-fade-up 0.3s ease-out both;
    }

        .fw-typing.is-visible {
            display: flex;
        }

        .fw-typing span {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: var(--fw-ai-accent);
            animation: fw-dot-bounce 1.2s infinite ease-in-out;
        }

            .fw-typing span:nth-child(2) {
                animation-delay: 0.15s;
            }

            .fw-typing span:nth-child(3) {
                animation-delay: 0.3s;
            }

    @@media (prefers-reduced-motion: reduce) {
        .fw-msg-row.fw-animate,
        .fw-msg-row.fw-animate .fw-bubble,
        .fw-typing,
        .fw-typing span {
            animation: none !important;
        }
    }
</style>

<div class="container py-4">
    <div class="fw-ai-card">

        <!-- Header -->
        @* The header shows the provider name (mock vs Gemini) so the user always knows
           whether they are talking to the real model or the offline mock. *@
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-robot text-primary"></i> AI Financial Advisor
                </h1>
                <div class="small text-muted d-flex align-items-center gap-2">
                    <span>Engine:</span>
                    <span class="badge bg-secondary text-uppercase">@Model.ActiveProvider</span>
                </div>
            </div>

            @* Clear history only appears when there is something to clear. *@
            @if (Model.ConversationHistory.Any())
            {
                <form asp-action="ClearHistory" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1">
                        <i class="bi bi-trash"></i> Clear history
                    </button>
                </form>
            }
        </div>

        <!-- Disclaimer -->
        @* Required by good practice: AI suggestions are not formal financial advice. *@
        <div class="fw-ai-disclaimer mb-4 d-flex align-items-start gap-2" role="note">
            <i class="bi bi-info-circle-fill flex-shrink-0 mt-1"></i>
            <div>
                <strong>Notice:</strong> AI-generated responses are for educational and informational purposes only and do not constitute formal financial advice.
            </div>
        </div>

        <!-- Chat stream -->
        @* Every message is a row with a bubble on the correct side (user right, bot left).
           The last bot message gets the "fw-animate" class so it fades in after the page reloads.
           The bot bubble's data-raw attribute is the source of truth: marked.parse will replace
           innerHTML with rendered Markdown (sanitised by DOMPurify) further down. *@
        <div class="fw-ai-chat-box mb-4" id="chatStream">
            @if (!Model.ConversationHistory.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-chat-square-text display-6 text-muted d-block mb-3"></i>
                    <p class="text-muted mb-0">No conversation yet. Pick a quick prompt below or type your question.</p>
                </div>
            }
            else
            {
                @foreach (var msg in Model.ConversationHistory)
                {
                    var isUser = msg.Sender == "User";

                    <div class="fw-msg-row @(isUser ? "is-user" : "is-bot") @(msg == Model.ConversationHistory.Last() && !isUser ? "fw-animate" : "")">
                        <div class="fw-bubble @(isUser ? "fw-bubble-user" : "fw-bubble-bot")">
                            <div class="fw-bubble-header">
                                <i class="bi @(isUser ? "bi-person-circle" : "bi-cpu")"></i>
                                @(isUser ? "You" : "Advisor")
                            </div>

                            @if (isUser)
                            {
                                @* User text is shown as-is (with whitespace preserved), not parsed as Markdown. *@
                                <div class="fw-plain">@msg.Message</div>
                            }
                            else
                            {
                                @* The raw text is stored in data-raw; the script below replaces the inner text
                                   with rendered + sanitised Markdown. If JS is disabled, the raw text is still readable. *@
                                <div class="fw-md" data-raw="@msg.Message">@msg.Message</div>
                            }

                            <div class="fw-bubble-time">@msg.Timestamp.ToString("HH:mm")</div>
                        </div>
                    </div>
                }
            }

            <!-- Typing indicator, shown while waiting for the reply -->
            <div class="fw-typing" id="typingIndicator" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>
        </div>

        <!-- Quick prompts -->
        @* Each pill has data-text; the script below copies it into the textarea when clicked. *@
        <div class="mb-4">
            <div class="fw-section-label mb-2">Quick prompts</div>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="fw-prompt-pill quick-prompt" data-text="Summarize my spending this month">
                    <i class="bi bi-graph-up me-1"></i> Summarize my spending
                </button>
                <button type="button" class="fw-prompt-pill quick-prompt" data-text="Where do I spend the most money?">
                    <i class="bi bi-pie-chart me-1"></i> Where do I spend the most?
                </button>
                <button type="button" class="fw-prompt-pill quick-prompt" data-text="How can I save more money every month?">
                    <i class="bi bi-piggy-bank me-1"></i> How can I save more?
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show py-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Question form -->
        @* The textarea is bounded at 500 characters, both server-side (AssistantViewModel)
           and client-side (maxlength), so the user cannot post a huge prompt by accident. *@
        <form asp-action="Index" method="post" id="advisorForm">
            @Html.AntiForgeryToken()

            <div class="d-flex justify-content-between align-items-center mb-2">
                <label asp-for="UserQuestion" class="fw-section-label mb-0">Your question</label>
                <span id="charCounter" class="fw-char-counter">0 / 500</span>
            </div>

            <textarea asp-for="UserQuestion" id="QuestionInput" class="form-control mb-1" rows="3" maxlength="500"
                      placeholder="Ask about your spending, savings, or budget..." required></textarea>
            <div class="d-flex justify-content-between align-items-center">
                <span asp-validation-for="UserQuestion" class="text-danger small"></span>
                <span class="fw-key-hint ms-auto">Enter to send, Shift+Enter for a new line</span>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" asp-for="IncludeTransactions" id="includeTxSwitch">
                    <label class="form-check-label small text-muted" for="includeTxSwitch">
                        Include my recent transactions (amount, type, description, date, currency)
                        <span class="d-block fw-semibold text-success">Your name, email, and password are never sent.</span>
                    </label>
                </div>

                <button type="submit" id="submitBtn" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2">
                    <span id="btnText"><i class="bi bi-send-fill"></i> Send</span>
                    <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @* marked: renders Markdown from the AI reply.
       DOMPurify: sanitises the rendered HTML, so any <script> or inline handler that the model
       produces is stripped before it reaches the DOM (XSS protection). *@
    <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const textarea = document.getElementById('QuestionInput');
            const counter = document.getElementById('charCounter');
            const chatStream = document.getElementById('chatStream');
            const form = document.getElementById('advisorForm');
            const submitBtn = document.getElementById('submitBtn');
            const btnText = document.getElementById('btnText');
            const btnSpinner = document.getElementById('btnSpinner');
            const typing = document.getElementById('typingIndicator');
            let isSending = false; // guards against double-submitting while the request is in-flight

            // Render Markdown in advisor replies, sanitized before insertion
            if (window.marked && window.DOMPurify) {
                marked.setOptions({ breaks: true, gfm: true });
                document.querySelectorAll('.fw-md[data-raw]').forEach(function(el) {
                    el.innerHTML = DOMPurify.sanitize(marked.parse(el.getAttribute('data-raw') || ''));
                });
            }

            // Auto-scroll to the latest message on load / after sending.
            function scrollToBottom(smooth) {
                if (!chatStream) return;
                chatStream.scrollTo({
                    top: chatStream.scrollHeight,
                    behavior: smooth ? 'smooth' : 'auto'
                });
            }
            scrollToBottom(false);

            // Character counter updates on every keystroke.
            function updateCounter() {
                counter.textContent = textarea.value.length + ' / 500';
            }
            textarea.addEventListener('input', updateCounter);
            updateCounter();

            // Quick prompts fill the textarea, then focus it.
            document.querySelectorAll('.quick-prompt').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    textarea.value = this.getAttribute('data-text') || this.textContent.trim();
                    updateCounter();
                    textarea.focus();
                });
            });

            // Enter sends, Shift+Enter inserts a new line (standard chat behaviour).
            // e.isComposing is checked so IME users (e.g. Chinese / Japanese input) do not send mid-composition.
            textarea.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
                    e.preventDefault();
                    if (textarea.value.trim().length === 0) return;
                    form.requestSubmit(submitBtn);
                }
            });

            // Submit: validate, block double-sends, show loading state
            form.addEventListener('submit', function(e) {
                if (isSending) {
                    e.preventDefault();
                    return;
                }
                // jQuery validation (from _ValidationScriptsPartial) checks the [Required] / [StringLength] rules.
                if (!$(form).valid()) {
                    return;
                }

                isSending = true;
                btnText.classList.add('d-none');           // hide "Send"
                btnSpinner.classList.remove('d-none');     // show spinner
                submitBtn.disabled = true;
                textarea.readOnly = true;

                if (typing) {
                    typing.classList.add('is-visible');    // show the "…" dots
                    scrollToBottom(true);
                }
            });
        });
    </script>
}
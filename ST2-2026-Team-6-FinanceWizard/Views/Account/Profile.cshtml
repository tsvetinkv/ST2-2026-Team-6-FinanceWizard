@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";

    var name = Model.Username ?? string.Empty;
    var initial = string.IsNullOrWhiteSpace(name) ? "?" : char.ToUpper(name.Trim()[0]).ToString();
    var hue = name.Aggregate(0, (acc, ch) => (acc * 31 + ch) % 360);

    bool deleteHasErrors = ViewData.ModelState
        .Any(kv => kv.Key.StartsWith("DeleteAccount") && kv.Value!.Errors.Count > 0);
}

<div class="fw-page-head">
    <div>
        <h1 class="fw-page-title">Profile</h1>
        <p class="fw-page-sub">Manage your photo, sign-in details, password and wallet currency.</p>
    </div>
</div>

@if (TempData["ProfileSuccess"] is string success)
{
    <div class="alert alert-success fw-profile-toast" role="status">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9" /></svg>
        <span>@success</span>
    </div>
}

<div class="fw-profile">

    @* ================= Left column ================= *@
    <aside class="fw-profile-side" aria-label="Profile summary">
        <div class="fw-panel fw-profile-card">
            @if (Model.PhotoUrl != null)
            {
                <img class="fw-profile-photo" src="@Model.PhotoUrl" alt="Your profile photo" />
            }
            else
            {
                <span class="fw-avatar fw-profile-avatar" style="--h:@hue" aria-hidden="true">@initial</span>
            }
            <div class="fw-profile-name">@Model.Username</div>
            <div class="fw-profile-email">@Model.Email</div>
            <div class="fw-profile-meta">
                <span class="fw-type-badge">Main wallet: @Model.CurrencyCode</span>
            </div>
        </div>

        <nav class="fw-panel fw-profile-nav" aria-label="Profile sections">
            <a href="#photo">Profile photo</a>
            <a href="#account">Sign-in details</a>
            <a href="#password">Password</a>
            <a href="#currency">Currency</a>
            <a href="#danger" class="is-danger">Delete account</a>
        </nav>
    </aside>

    @* ================= Right column ================= *@
    <div class="fw-profile-main">

        @* ---------- Profile photo ---------- *@
        <section id="photo" class="fw-panel fw-profile-section" aria-labelledby="h-photo">
            <header class="fw-profile-head">
                <h2 id="h-photo">Profile photo</h2>
                <p>JPG, PNG or WebP, up to 2 MB.</p>
            </header>

            <div class="fw-photo-row">
                <div class="fw-photo-frame" id="photo-frame">
                    @if (Model.PhotoUrl != null)
                    {
                        <img class="fw-profile-photo" src="@Model.PhotoUrl" alt="Your profile photo" />
                    }
                    else
                    {
                        <span class="fw-avatar fw-profile-avatar" style="--h:@hue" aria-hidden="true">@initial</span>
                    }
                </div>

                <div class="fw-photo-controls">
                    <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data">
                        <input type="file" name="photo" id="photo-input" class="visually-hidden"
                               accept="image/png,image/jpeg,image/webp" />
                        <label for="photo-input" class="btn btn-secondary fw-btn-sm">Choose image</label>
                        <button type="submit" id="btn-photo" class="btn btn-primary fw-btn-sm" disabled>Upload photo</button>
                        <span id="photo-name" class="fw-muted">No file chosen</span>
                        @Html.ValidationMessage("Photo", new { @class = "fw-error w-100" })
                    </form>

                    @if (Model.PhotoUrl != null)
                    {
                        <form asp-action="RemovePhoto" method="post">
                            <button type="submit" class="btn btn-outline-fw fw-btn-sm">Remove photo</button>
                        </form>
                    }
                </div>
            </div>
        </section>

        @* ---------- Sign-in details + username ---------- *@
        <section id="account" class="fw-panel fw-profile-section" aria-labelledby="h-account">
            <header class="fw-profile-head">
                <h2 id="h-account">Sign-in details</h2>
                <p>Your email is used to sign in and can't be changed here.</p>
            </header>

            <div class="fw-profile-readonly">
                <span class="fw-profile-readonly-label">Email</span>
                <span class="fw-profile-readonly-value">@Model.Email</span>
            </div>

            <form asp-action="ChangeUsername" method="post" novalidate="novalidate">
                <div class="mb-3">
                    <label asp-for="ChangeUsername.Username" class="fw-label">Username</label>
                    <input asp-for="ChangeUsername.Username" class="form-control"
                           autocomplete="username" data-original="@Model.Username" />
                    <span asp-validation-for="ChangeUsername.Username" class="fw-error"></span>
                </div>
                <div class="fw-profile-actions">
                    <button type="submit" id="btn-username" class="btn btn-primary fw-btn-sm" disabled>Save username</button>
                </div>
            </form>
        </section>

        @* ---------- Password ---------- *@
        <section id="password" class="fw-panel fw-profile-section" aria-labelledby="h-password">
            <header class="fw-profile-head">
                <h2 id="h-password">Password</h2>
                <p>Use at least 6 characters. A longer password with numbers and capital letters is safer.</p>
            </header>

            <form asp-action="ChangePassword" method="post" novalidate="novalidate">
                <div class="mb-3">
                    <label asp-for="ChangePassword.CurrentPassword" class="fw-label">Current password</label>
                    <div class="fw-pw">
                        <input asp-for="ChangePassword.CurrentPassword" class="form-control" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="ChangePassword.CurrentPassword" class="fw-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ChangePassword.NewPassword" class="fw-label">New password</label>
                    <div class="fw-pw">
                        <input asp-for="ChangePassword.NewPassword" class="form-control" autocomplete="new-password" />
                    </div>
                    <div class="fw-meter" id="pw-meter" data-level="0" aria-live="polite">
                        <span></span><span></span><span></span><span></span>
                        <em id="pw-meter-text"></em>
                    </div>
                    <span asp-validation-for="ChangePassword.NewPassword" class="fw-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ChangePassword.ConfirmNewPassword" class="fw-label">Confirm new password</label>
                    <div class="fw-pw">
                        <input asp-for="ChangePassword.ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ChangePassword.ConfirmNewPassword" class="fw-error"></span>
                </div>

                <div class="fw-profile-actions">
                    <button type="submit" class="btn btn-primary fw-btn-sm">Change password</button>
                </div>
            </form>
        </section>

        @* ---------- Currency ---------- *@
        <section id="currency" class="fw-panel fw-profile-section" aria-labelledby="h-currency">
            <header class="fw-profile-head">
                <h2 id="h-currency">Main wallet currency</h2>
                <p>Changes the currency of your main wallet only.</p>
            </header>

            <form asp-action="ChangeCurrency" method="post" novalidate="novalidate">
                <fieldset class="fw-form-group">
                    <legend class="fw-label">Choose a currency</legend>
                    <div class="fw-cur-grid">
                        @for (int i = 0; i < CurrencyInfo.All.Count; i++)
                        {
                            var c = CurrencyInfo.All[i];
                            <div class="fw-cur">
                                <input type="radio" asp-for="ChangeCurrency.Currency" value="@c.Code" id="cur-@i" />
                                <label for="cur-@i">
                                    <span class="fw-cur-symbol">@c.Code</span>
                                    <span class="fw-cur-name">@c.Name</span>
                                </label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="ChangeCurrency.Currency" class="fw-error"></span>
                </fieldset>

                <p class="fw-profile-note">
                    <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="10" r="8" /><path d="M10 9v5M10 6.2v.1" /></svg>
                    <span>
                        The balance and all transaction amounts of your main wallet are converted at the current
                        exchange rate (ECB reference rates). Your other wallets keep their own currencies.
                        Switching back later uses that day's rate, so amounts can differ slightly.
                    </span>
                </p>

                <p class="fw-fx" id="fx-preview" aria-live="polite"></p>

                <div class="fw-profile-actions">
                    <button type="submit" id="btn-currency" class="btn btn-primary fw-btn-sm">Convert and save</button>
                </div>
            </form>
        </section>

        @* ---------- Delete account ---------- *@
        <section id="danger" class="fw-panel fw-profile-section fw-danger-zone" aria-labelledby="h-danger">
            <details class="fw-profile-details" @(deleteHasErrors ? "open" : null)>
                <summary>
                    <span>
                        <strong id="h-danger">Delete account</strong>
                        <small>Your account, wallet, transactions and photo are deleted permanently.</small>
                    </span>
                </summary>

                <form asp-action="DeleteAccount" method="post" novalidate="novalidate" class="mt-3"
                      onsubmit="return confirm('Are you sure you want to delete your account? This can\'t be undone.');">
                    <div class="mb-3">
                        <label asp-for="DeleteAccount.Password" class="fw-label">Enter your password to confirm</label>
                        <div class="fw-pw">
                            <input asp-for="DeleteAccount.Password" class="form-control" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="DeleteAccount.Password" class="fw-error"></span>
                    </div>
                    <div class="fw-profile-actions">
                        <button type="submit" class="btn fw-btn-danger fw-btn-sm">Delete account permanently</button>
                    </div>
                </form>
            </details>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
            // Password strength
            var np = document.getElementById('ChangePassword_NewPassword');
            var meter = document.getElementById('pw-meter');
            var meterText = document.getElementById('pw-meter-text');
            var labels = ['', 'Weak', 'Fair', 'Good', 'Strong'];
            if (np && meter) {
                np.addEventListener('input', function() {
                    var v = np.value, s = 0;
                    if (v.length >= 6) s++;
                    if (v.length >= 10) s++;
                    if (/[a-z]/.test(v) && /[A-Z]/.test(v) && /\d/.test(v)) s++;
                    if (/[^A-Za-z0-9]/.test(v)) s++;
                    if (!v) s = 0;
                    meter.dataset.level = s;
                    meterText.textContent = labels[s];
                });
            }

            // Save username only when it changed
            var un = document.getElementById('ChangeUsername_Username');
            var unBtn = document.getElementById('btn-username');
            if (un && unBtn) {
                var sync = function() {
                    var val = un.value.trim();
                    unBtn.disabled = val === '' || val === un.dataset.original;
                };
                un.addEventListener('input', sync);
                sync();
            }

            // Photo: preview + client-side checks
            var fileInput = document.getElementById('photo-input');
            var fileName = document.getElementById('photo-name');
            var photoBtn = document.getElementById('btn-photo');
            var frame = document.getElementById('photo-frame');
            if (fileInput) {
                fileInput.addEventListener('change', function() {
                    var f = fileInput.files[0];
                    photoBtn.disabled = true;
                    if (!f) { fileName.textContent = 'No file chosen'; return; }
                    var okType = ['image/jpeg', 'image/png', 'image/webp'].indexOf(f.type) !== -1;
                    if (!okType) { fileName.textContent = 'Only JPG, PNG or WebP images are allowed.'; fileInput.value = ''; return; }
                    if (f.size > 2 * 1024 * 1024) { fileName.textContent = 'The image is too large (max 2 MB).'; fileInput.value = ''; return; }
                    fileName.textContent = f.name;
                    var img = document.createElement('img');
                    img.className = 'fw-profile-photo';
                    img.alt = 'Preview of the selected photo';
                    img.src = URL.createObjectURL(f);
                    frame.replaceChildren(img);
                    photoBtn.disabled = false;
                });
            }

            // Currency: live rate preview
            var radios = document.querySelectorAll('input[name="ChangeCurrency.Currency"]');
            var fx = document.getElementById('fx-preview');
            var curBtn = document.getElementById('btn-currency');
            var checked = document.querySelector('input[name="ChangeCurrency.Currency"]:checked');
            var initial = checked ? checked.value : null;
            var fmt = function(n) {
                return Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            };
            radios.forEach(function(r) {
                r.addEventListener('change', function() {
                    if (r.value === initial) {
                        fx.textContent = 'This is already your currency.';
                        curBtn.disabled = true;
                        return;
                    }
                    fx.textContent = 'Loading the exchange rate…';
                    curBtn.disabled = true;
                    fetch('@Url.Action("ExchangeRate", "Account")?to=' + encodeURIComponent(r.value),
                        { headers: { 'Accept': 'application/json' } })
                        .then(function(res) {
                            return res.json().then(function(d) { return { ok: res.ok, d: d }; });
                        })
                        .then(function(r2) {
                            if (!r2.ok) {
                                var err = new Error('request failed');
                                err.userMessage = r2.d && r2.d.error;
                                throw err;
                            }
                            var d = r2.d;
                            fx.textContent = d.rate == null
                                ? 'Your main wallet has no money or transactions, so only the currency changes.'
                                : '1 ' + d.from + ' = ' + d.rate.toFixed(4) + ' ' + d.to + '. Your main wallet balance of ' +
                                fmt(d.before) + ' ' + d.from + ' becomes ' + fmt(d.after) + ' ' + d.to + '.';
                            curBtn.disabled = false;
                        })
                        .catch(function(e) {
                            fx.textContent = (e && e.userMessage) ||
                                "Couldn't load the exchange rate. Try again in a few minutes.";
                        });
                });
            });

            // Scroll to the first field with an error
            var bad = document.querySelector('.input-validation-error') ||
                document.querySelector('.field-validation-error');
            if (bad) {
                bad.scrollIntoView({ block: 'center' });
                if (bad.focus) bad.focus({ preventScroll: true });
            }
        })();
    </script>
}

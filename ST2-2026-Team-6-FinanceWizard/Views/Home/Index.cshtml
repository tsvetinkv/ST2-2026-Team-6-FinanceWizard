@using System.Globalization
@using System.Text.Json
@model ST2_2026_Team_6_FinanceWizard.Models.HomeDashboardViewModel

@{
    ViewData["Title"] = "Home";
    bool isAuthenticated = User.Identity?.IsAuthenticated ?? false;

    // Demo data for the mock chart (values in thousands of euros)
    var months = new[] { "May", "Jun", "Jul", "Aug", "Sep", "Oct" };
    var income = new[] { 3.2, 3.4, 3.1, 3.8, 3.6, 4.2 };
    var expense = new[] { 2.4, 2.7, 2.9, 2.5, 2.8, 2.6 };

    const double baseY = 200;   // chart baseline
    const double unit = 36;     // pixels per 1k
    const double left = 48;     // left padding for axis labels
    const double groupW = 70;   // width of one month group

    string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    // Razor reserves the literal text element name, so SVG labels are emitted through this helper.
    Microsoft.AspNetCore.Html.HtmlString T(double x, double y, string anchor, string label) =>
        new Microsoft.AspNetCore.Html.HtmlString(
            $"<text x=\"{F(x)}\" y=\"{F(y)}\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(label)}</text>");
}

@if (isAuthenticated)
{
    var wallets = Model.Wallets;

    <section class="fw-hero mb-4" aria-labelledby="welcome-heading">
        <span class="fw-blob fw-blob-blue" aria-hidden="true"></span>
        <span class="fw-blob fw-blob-gold" aria-hidden="true"></span>
        <h1 id="welcome-heading" class="fw-headline mb-3">Welcome back, <span class="fw-highlight">@User.Identity?.Name</span></h1>
        <p class="fw-lead mb-4">Your wallet is ready. Review your latest activity or record a new transaction.</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary btn-lg" asp-controller="Transactions" asp-action="Index">View transactions</a>
            <a class="btn btn-outline-fw btn-lg" asp-controller="Transactions" asp-action="Create">New transaction</a>
        </div>
    </section>

    <h2 class="fw-section-label">Manage</h2>
    <nav class="fw-tile-grid" aria-label="Sections">
        <a class="fw-tile" style="--h:215" asp-controller="Transactions" asp-action="Index">
            <span class="fw-avatar" aria-hidden="true"><partial name="_SectionIcon" model="@("transactions")" /></span>
            <span class="fw-tile-title">Transactions</span>
            <span class="fw-tile-count">@Model.TransactionCount</span>
            <span class="fw-tile-desc">Income &amp; expenses</span>
            <svg class="fw-tile-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="fw-tile" style="--h:150" asp-controller="Wallet" asp-action="Index">
            <span class="fw-avatar" aria-hidden="true"><partial name="_SectionIcon" model="@("wallets")" /></span>
            <span class="fw-tile-title">Wallets</span>
            <span class="fw-tile-count">@wallets.Count</span>
            <span class="fw-tile-desc">Spending &amp; savings</span>
            <svg class="fw-tile-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="fw-tile" style="--h:28" asp-controller="Merchant" asp-action="Index">
            <span class="fw-avatar" aria-hidden="true"><partial name="_SectionIcon" model="@("merchants")" /></span>
            <span class="fw-tile-title">Merchants</span>
            <span class="fw-tile-count">@Model.MerchantCount</span>
            <span class="fw-tile-desc">Shops &amp; services</span>
            <svg class="fw-tile-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="fw-tile" style="--h:275" asp-controller="Category" asp-action="Index">
            <span class="fw-avatar" aria-hidden="true"><partial name="_SectionIcon" model="@("categories")" /></span>
            <span class="fw-tile-title">Categories</span>
            <span class="fw-tile-count">@Model.CategoryCount</span>
            <span class="fw-tile-desc">Group your spending</span>
            <svg class="fw-tile-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="fw-tile" style="--h:340" asp-controller="Tag" asp-action="Index">
            <span class="fw-avatar" aria-hidden="true"><partial name="_SectionIcon" model="@("tags")" /></span>
            <span class="fw-tile-title">Tags</span>
            <span class="fw-tile-count">@Model.TagCount</span>
            <span class="fw-tile-desc">Flexible labels</span>
            <svg class="fw-tile-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
    </nav>

    var kpi = Model.Kpis;
    string kpiSymbol = Money.Symbol(kpi.Currency);
    string chartJson = JsonSerializer.Serialize(
        new { currency = kpi.Currency, symbol = kpiSymbol, months = Model.Monthly, categories = Model.SpendingByCategory },
        new JsonSerializerOptions(JsonSerializerDefaults.Web));
    string MoneyOf(decimal v) => Money.Format(v, kpi.Currency);

    <link rel="stylesheet" href="~/css/fw-dashboard.css" asp-append-version="true" />

    <div class="fw-kpi-head mt-4">
        <h2 class="fw-section-label">This month</h2>
        @if (Model.AvailableCurrencies.Count > 1)
        {
            <nav class="fw-currency-switch" aria-label="Show statistics in currency">
                @foreach (var cur in Model.AvailableCurrencies)
                {
                    bool active = string.Equals(cur, kpi.Currency, StringComparison.OrdinalIgnoreCase);
                    <a asp-controller="Home" asp-action="Index" asp-route-currency="@cur"
                       class="fw-currency-link @(active ? "is-active" : "")"
                       aria-current="@(active ? "true" : null)">@cur</a>
                }
            </nav>
        }
    </div>
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3 d-flex">
            <article class="fw-kpi-card is-income">
                <div class="fw-kpi-card-label">Income</div>
                <div class="fw-kpi-card-value is-income">+@MoneyOf(kpi.IncomeThisMonth)</div>
                <div class="fw-kpi-card-meta">Money received</div>
            </article>
        </div>
        <div class="col-6 col-lg-3 d-flex">
            <article class="fw-kpi-card is-expense">
                <div class="fw-kpi-card-label">Expenses</div>
                <div class="fw-kpi-card-value is-expense">&minus;@MoneyOf(kpi.ExpensesThisMonth)</div>
                <div class="fw-kpi-card-meta">
                    @if (kpi.ExpenseChangePercent is decimal change)
                    {
                        <text>@(change > 0 ? "+" : "")@change.ToString("0", CultureInfo.InvariantCulture)% vs. last month</text>
                    }
                    else
                    {
                        <text>Money spent</text>
                    }
                </div>
            </article>
        </div>
        <div class="col-6 col-lg-3 d-flex">
            <article class="fw-kpi-card @(kpi.NetThisMonth >= 0 ? "is-income" : "is-expense")">
                <div class="fw-kpi-card-label">Net</div>
                <div class="fw-kpi-card-value @(kpi.NetThisMonth >= 0 ? "is-income" : "is-expense")">@(kpi.NetThisMonth >= 0 ? "+" : "−")@MoneyOf(Math.Abs(kpi.NetThisMonth))</div>
                <div class="fw-kpi-card-meta">Income minus expenses</div>
            </article>
        </div>
        <div class="col-6 col-lg-3 d-flex">
            <article class="fw-kpi-card">
                <div class="fw-kpi-card-label">Savings rate</div>
                <div class="fw-kpi-card-value @(kpi.SavingsRatePercent is decimal sr ? (sr >= 0 ? "is-income" : "is-expense") : "")">@(kpi.SavingsRatePercent is decimal rate ? rate.ToString("0", CultureInfo.InvariantCulture) + "%" : "–")</div>
                <div class="fw-kpi-card-meta">@(kpi.SavingsRatePercent == null ? "No income recorded yet" : "Share of income kept")</div>
            </article>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <section class="fw-panel h-100" aria-labelledby="home-monthly-h">
                <div class="fw-panel-head">
                    <h2 id="home-monthly-h">Income vs. expenses</h2>
                    <span class="fw-muted small">Last @Model.Monthly.Count months &middot; @kpi.Currency</span>
                </div>
                @if (Model.HasChartData)
                {
                    <div class="fw-chart-box">
                        <canvas id="fwMonthlyChart" role="img" aria-label="Bar chart of income and expenses for each of the last @Model.Monthly.Count months"></canvas>
                    </div>
                    <table class="visually-hidden">
                        <caption>Income and expenses per month</caption>
                        <thead><tr><th scope="col">Month</th><th scope="col">Income</th><th scope="col">Expenses</th></tr></thead>
                        <tbody>
                            @foreach (var m in Model.Monthly)
                            {
                                <tr><th scope="row">@m.Label</th><td>@MoneyOf(m.Income)</td><td>@MoneyOf(m.Expense)</td></tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="fw-list-empty">No transactions in the last @Model.Monthly.Count months. <a asp-controller="Transactions" asp-action="Create">Add one</a> to see your chart.</div>
                }
            </section>
        </div>
        <div class="col-lg-5">
            <section class="fw-panel h-100" aria-labelledby="home-category-h">
                <div class="fw-panel-head">
                    <h2 id="home-category-h">Spending by category</h2>
                    <span class="fw-muted small">Last @Model.Monthly.Count months</span>
                </div>
                @if (Model.SpendingByCategory.Any())
                {
                    <div class="fw-chart-box">
                        <canvas id="fwCategoryChart" role="img" aria-label="Doughnut chart of spending by category"></canvas>
                    </div>
                    <table class="visually-hidden">
                        <caption>Spending by category</caption>
                        <thead><tr><th scope="col">Category</th><th scope="col">Spent</th></tr></thead>
                        <tbody>
                            @foreach (var c in Model.SpendingByCategory)
                            {
                                <tr><th scope="row">@c.Name</th><td>@MoneyOf(c.Total)</td></tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="fw-list-empty">No expenses yet.</div>
                }
            </section>
        </div>
    </div>
    <div id="fwDashboardData" data-chart="@chartJson" hidden></div>

    <div class="row g-3 mb-4">
        <div class="col-lg-5">
            <section class="fw-panel h-100" aria-labelledby="home-wallets-h">
                <div class="fw-panel-head">
                    <h2 id="home-wallets-h">Your wallets</h2>
                    <a asp-controller="Wallet" asp-action="Index" class="small">Manage</a>
                </div>
                @if (wallets.Any())
                {
                    <ul class="fw-list">
                        @foreach (var w in wallets)
                        {
                            bool sv = w.Type == WalletTypes.Savings;
                            <li>
                                <div class="fw-list-main">
                                    <div class="fw-list-title">@w.Name</div>
                                    <span class="fw-type-badge @(sv ? "is-savings" : "")">
                                        <partial name="_SectionIcon" model="@(sv ? "savings" : "spending")" />
                                        @(sv ? "Savings" : "Spending
@model IEnumerable<Tag>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Tags</h2>
    <a asp-action="Create" class="btn btn-success">+ Add Tag</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="searchName" value="@ViewData["SearchName"]" class="form-control" placeholder="Search tags..." />
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div class="d-flex flex-wrap gap-2">
@foreach (var item in Model)
{
    <span class="badge bg-secondary p-2">#@item.Name</span>
}
</div>
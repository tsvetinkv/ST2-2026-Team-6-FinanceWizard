@model IEnumerable<Merchant>
@{
    ViewData["Title"] = "Merchants";
    var merchants = Model.ToList();
    var search = ViewData["SearchName"] as string;
}

@* Page header with count badge and "Add merchant" CTA. *@
<div class="fw-page-head">
    <div>
        <h1 class="fw-page-title">Merchants<span class="fw-count-badge">@merchants.Count</span></h1>
        <p class="fw-page-sub">The shops and services you pay.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg>
        Add merchant
    </a>
</div>

@* Search form (GET keeps the query string, so refresh / back keep the search). *@
<form method="get" asp-action="Index" class="fw-panel fw-filter" role="search" aria-label="Search merchants">
    <div class="fw-filter-field fw-filter-search">
        <label for="searchName" class="fw-label">Search</label>
        <input type="search" id="searchName" name="searchName" value="@search" class="form-control fw-control-sm" placeholder="Search merchants" autocomplete="off" />
    </div>
    <div class="fw-filter-actions">
        <button type="submit" class="btn btn-primary fw-btn-sm">Search</button>
        <a asp-action="Index" class="btn btn-secondary fw-btn-sm">Reset</a>
    </div>
</form>

@if (merchants.Any())
{
    @* Card grid: one card per merchant.
       - If a logo exists, it's shown; otherwise the first letter of the name on a
         hue derived from the name (stable across page loads). *@
    <div class="fw-card-grid">
        @foreach (var item in merchants)
        {
            <article class="fw-panel fw-item-card">
                @if (!string.IsNullOrWhiteSpace(item.LogoUrl))
                {
                    <span class="fw-avatar fw-avatar-logo" aria-hidden="true"><img src="@Url.Content("~/" + item.LogoUrl)" alt="" loading="lazy" /></span>
                }
                else
                {
                    <span class="fw-avatar" style="--h:@Hue.Of(item.Name)" aria-hidden="true">@item.Name.Substring(0, 1).ToUpperInvariant()</span>
                }
                <div class="fw-item-main">
                    <div class="fw-item-name">@item.Name</div>
                    <div class="fw-item-meta">Merchant</div>
                </div>
                <div class="fw-item-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="fw-icon-btn" title="Edit merchant" aria-label="Edit merchant @item.Name">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
                    </a>
                    @* Delete is POST with a confirmation. Transactions that reference the merchant
                       are preserved (their MerchantId is set to null by the controller). *@
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                          onsubmit="return confirm('Delete this merchant? Transactions that use it keep their amount and date but lose the merchant.');">
                        <button type="submit" class="fw-icon-btn is-danger" title="Delete merchant" aria-label="Delete merchant @item.Name">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6" /></svg>
                        </button>
                    </form>
                </div>
            </article>
        }
    </div>
}
else
{
    @* Empty state with two variants: filtered-out vs no data at all. *@
    <section class="fw-panel">
        <div class="fw-empty">
            <partial name="_SectionIcon" model="@("merchants")" />
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <h2>No matching merchants</h2>
                <p>Try a different search term.</p>
                <a asp-action="Index" class="btn btn-secondary fw-btn-sm">Reset search</a>
            }
            else
            {
                <h2>No merchants yet</h2>
                <p>Add the places you spend money at.</p>
                <a asp-action="Create" class="btn btn-primary fw-btn-sm">Add merchant</a>
            }
        </div>
    </section>
}

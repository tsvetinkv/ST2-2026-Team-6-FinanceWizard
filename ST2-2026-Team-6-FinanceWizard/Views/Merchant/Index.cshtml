@model IEnumerable<Merchant>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Merchants</h2>
    <a asp-action="Create" class="btn btn-success">+ Add Merchant</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="searchName" value="@ViewData["SearchName"]" class="form-control" placeholder="Search merchants..." />
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<ul class="list-group">
@foreach (var item in Model)
{
    <li class="list-group-item">@item.Name</li>
}
</ul>